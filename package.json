{
  "name": "zario-express",
  "version": "1.1.0",
  "description": "Express logging middleware for Zario.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check src tests",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0",
    "zario": "^0.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "express": "^5.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "zario": "file:../../zario",
    "@types/bun": "^1.3.0",
    "@biomejs/biome": "^2.0.0",
    "express4": "npm:express@^4.19.2",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0"
  },
  "packageManager": "bun@1.4.0",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-dami/zario-express.git"
  }
}
